[Unit]
Description=Personal Agent isolated Hermes gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kirin
Group=kirin
WorkingDirectory=/home/kirin/apps/personal_agent
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Shanghai
ExecStart=/home/kirin/apps/personal_agent/.venv/bin/python /home/kirin/apps/personal_agent/scripts/start_hermes.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
