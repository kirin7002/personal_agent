# Copy to .env locally; never commit or paste real credentials into chat.
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=
DASHSCOPE_API_KEY=
# Backend model endpoint used by the isolated Hermes setup helper.
BAILIAN_ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
BAILIAN_MODEL=deepseek-v4.1-flash-1017
# Optional for Qwen Audio: empty uses the regional shared DashScope endpoint.
BAILIAN_WORKSPACE_ID=
BAILIAN_REGION=cn-beijing
# A configurable implementation default, not a final model selection.
# Optional separate S2S credential; falls back to DASHSCOPE_API_KEY when empty.
QWEN_AUDIO_API_KEY=
QWEN_AUDIO_MODEL=qwen-audio-3.1-realtime-flash
QWEN_AUDIO_VOICE=longanqian_v3.1
# Optional explicit proxy URL for the audio service; empty means direct.
QWEN_AUDIO_PROXY=
AGENT_TASK_TIMEOUT=120
DIRECT_COMPLETION_ENABLED=true
CANDIDATE_PRELOAD_ENABLED=true
CANDIDATE_PRELOAD_MAX_TOOLS=3
CANDIDATE_RELATED_MAX_TOOLS=4
CANDIDATE_PRELOAD_MAX_CHARS=12000
PREVIEW_DB=.data/preview.sqlite3
