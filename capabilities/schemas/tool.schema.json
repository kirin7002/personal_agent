{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "control",
        "manual",
        "status"
      ]
    },
    "category_path": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "enabled": {
      "type": "boolean"
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "mock": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "prepare_only"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "static"
            },
            "data": {}
          },
          "required": [
            "mode",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "argument_lookup"
            },
            "argument": {
              "type": "string",
              "minLength": 1
            },
            "cases": {
              "type": "object",
              "minProperties": 1
            }
          },
          "required": [
            "mode",
            "argument",
            "cases"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "profile_pointer"
            },
            "pointer": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "required": [
            "mode",
            "pointer"
          ],
          "additionalProperties": false
        }
      ]
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object"
          }
        },
        "required": [
          "instruction",
          "arguments"
        ],
        "additionalProperties": false
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pointer": {
            "type": "string",
            "pattern": "^/"
          },
          "equals": {},
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "pointer",
          "equals",
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "version",
    "kind",
    "category_path",
    "title",
    "description",
    "aliases",
    "enabled",
    "input_schema",
    "output_schema",
    "mock",
    "examples"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vehicle capability tool v1"
}
