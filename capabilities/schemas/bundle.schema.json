{
  "type": "object",
  "properties": {
    "format_version": {
      "const": "capability-catalog/v1"
    },
    "package": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version",
        "description"
      ],
      "additionalProperties": false
    },
    "directories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "related_query_paths": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            }
          }
        },
        "required": [
          "path",
          "title",
          "description",
          "aliases"
        ],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Vehicle capability directory v1"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "control",
              "manual",
              "status"
            ]
          },
          "category_path": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "enabled": {
            "type": "boolean"
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          },
          "mock": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "prepare_only"
                  }
                },
                "required": [
                  "mode"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "static"
                  },
                  "data": {}
                },
                "required": [
                  "mode",
                  "data"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "argument_lookup"
                  },
                  "argument": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cases": {
                    "type": "object",
                    "minProperties": 1
                  }
                },
                "required": [
                  "mode",
                  "argument",
                  "cases"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "profile_pointer"
                  },
                  "pointer": {
                    "type": "string",
                    "pattern": "^/"
                  }
                },
                "required": [
                  "mode",
                  "pointer"
                ],
                "additionalProperties": false
              }
            ]
          },
          "examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "instruction": {
                  "type": "string",
                  "minLength": 1
                },
                "arguments": {
                  "type": "object"
                }
              },
              "required": [
                "instruction",
                "arguments"
              ],
              "additionalProperties": false
            }
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pointer": {
                  "type": "string",
                  "pattern": "^/"
                },
                "equals": {},
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "pointer",
                "equals",
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "version",
          "kind",
          "category_path",
          "title",
          "description",
          "aliases",
          "enabled",
          "input_schema",
          "output_schema",
          "mock",
          "examples"
        ],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Vehicle capability tool v1"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "data"
        ],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Vehicle capability profile v1"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "control",
              "query",
              "cross_domain"
            ]
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "object",
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "prepared",
                  "answered",
                  "mixed",
                  "unsupported",
                  "partial",
                  "failed"
                ]
              },
              "calls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "tool_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "arguments": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "tool_id",
                    "arguments"
                  ],
                  "additionalProperties": false
                }
              },
              "required_domains": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "control",
                    "manual",
                    "status"
                  ]
                },
                "uniqueItems": true
              }
            },
            "required": [
              "outcome",
              "calls",
              "required_domains"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "instruction",
          "profile_id",
          "expected"
        ],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Vehicle capability scenario v1"
      }
    }
  },
  "required": [
    "format_version",
    "package",
    "directories",
    "tools",
    "profiles",
    "scenarios"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vehicle capability bundle v1"
}
