{
  "id": "control.windows.close",
  "version": "1.0.0",
  "kind": "control",
  "category_path": [
    "control",
    "windows"
  ],
  "title": "关闭车窗",
  "description": "关闭车窗。仅生成调用结构，所有范围为模拟定义，不执行真实车辆控制。",
  "aliases": [
    "关闭车窗",
    "车窗",
    "close"
  ],
  "enabled": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "window": {
        "type": "string",
        "enum": [
          "front_left",
          "front_right",
          "rear_left",
          "rear_right",
          "all"
        ],
        "description": "左前、右前、左后、右后、全部"
      }
    },
    "required": [
      "window"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "prepared": {
        "const": true
      }
    },
    "required": [
      "prepared"
    ],
    "additionalProperties": false
  },
  "mock": {
    "mode": "prepare_only"
  },
  "examples": [
    {
      "instruction": "关闭所有车窗",
      "arguments": {
        "window": "all"
      }
    }
  ]
}
