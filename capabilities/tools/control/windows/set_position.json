{
  "id": "control.windows.set_position",
  "version": "1.0.0",
  "kind": "control",
  "category_path": [
    "control",
    "windows"
  ],
  "title": "设置车窗开度",
  "description": "设置车窗开度。仅生成调用结构，所有范围为模拟定义，不执行真实车辆控制。",
  "aliases": [
    "设置车窗开度",
    "车窗",
    "set position"
  ],
  "enabled": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "window": {
        "type": "string",
        "enum": [
          "front_left",
          "front_right",
          "rear_left",
          "rear_right",
          "all"
        ],
        "description": "左前、右前、左后、右后、全部"
      },
      "open_percent": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      }
    },
    "required": [
      "window",
      "open_percent"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "prepared": {
        "const": true
      }
    },
    "required": [
      "prepared"
    ],
    "additionalProperties": false
  },
  "mock": {
    "mode": "prepare_only"
  },
  "examples": [
    {
      "instruction": "左前车窗打开一半",
      "arguments": {
        "window": "front_left",
        "open_percent": 50
      }
    }
  ]
}
