{
  "id": "control.multimedia.playback",
  "version": "1.0.0",
  "kind": "control",
  "category_path": [
    "control",
    "multimedia"
  ],
  "title": "控制媒体播放",
  "description": "控制媒体播放。仅生成调用结构，所有范围为模拟定义，不执行真实车辆控制。",
  "aliases": [
    "控制媒体播放",
    "多媒体",
    "playback"
  ],
  "enabled": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "play",
          "pause",
          "stop",
          "next",
          "previous"
        ]
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "prepared": {
        "const": true
      }
    },
    "required": [
      "prepared"
    ],
    "additionalProperties": false
  },
  "mock": {
    "mode": "prepare_only"
  },
  "examples": [
    {
      "instruction": "暂停媒体播放",
      "arguments": {
        "action": "pause"
      }
    }
  ]
}
