{
  "id": "control.multimedia.set_volume",
  "version": "1.0.0",
  "kind": "control",
  "category_path": [
    "control",
    "multimedia"
  ],
  "title": "设置媒体音量",
  "description": "设置媒体音量。仅生成调用结构，所有范围为模拟定义，不执行真实车辆控制。",
  "aliases": [
    "设置媒体音量",
    "多媒体",
    "set volume"
  ],
  "enabled": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "volume_percent": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      }
    },
    "required": [
      "volume_percent"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "prepared": {
        "const": true
      }
    },
    "required": [
      "prepared"
    ],
    "additionalProperties": false
  },
  "mock": {
    "mode": "prepare_only"
  },
  "examples": [
    {
      "instruction": "媒体音量设为30%",
      "arguments": {
        "volume_percent": 30
      }
    }
  ]
}
