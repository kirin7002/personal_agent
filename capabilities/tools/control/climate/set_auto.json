{
  "id": "control.climate.set_auto",
  "version": "1.0.0",
  "kind": "control",
  "category_path": [
    "control",
    "climate"
  ],
  "title": "空调自动模式",
  "description": "空调自动模式。仅生成调用结构，所有范围为模拟定义，不执行真实车辆控制。",
  "aliases": [
    "空调自动模式",
    "空调",
    "set auto"
  ],
  "enabled": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "zone": {
        "type": "string",
        "enum": [
          "driver",
          "passenger",
          "rear",
          "all"
        ],
        "description": "主驾、副驾、后排、全部"
      },
      "enabled": {
        "type": "boolean"
      }
    },
    "required": [
      "zone",
      "enabled"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "prepared": {
        "const": true
      }
    },
    "required": [
      "prepared"
    ],
    "additionalProperties": false
  },
  "mock": {
    "mode": "prepare_only"
  },
  "examples": [
    {
      "instruction": "所有分区空调开启自动模式",
      "arguments": {
        "zone": "all",
        "enabled": true
      }
    }
  ]
}
