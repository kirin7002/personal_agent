{
  "id": "control.climate.set_temperature",
  "version": "1.0.0",
  "kind": "control",
  "category_path": [
    "control",
    "climate"
  ],
  "title": "设置空调温度",
  "description": "设置空调温度。仅生成调用结构，所有范围为模拟定义，不执行真实车辆控制。",
  "aliases": [
    "设置空调温度",
    "空调",
    "set temperature"
  ],
  "enabled": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "zone": {
        "type": "string",
        "enum": [
          "driver",
          "passenger",
          "rear",
          "all"
        ],
        "description": "主驾、副驾、后排、全部"
      },
      "temperature_c": {
        "type": "number",
        "minimum": 16,
        "maximum": 30,
        "description": "摄氏度"
      }
    },
    "required": [
      "zone",
      "temperature_c"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "prepared": {
        "const": true
      }
    },
    "required": [
      "prepared"
    ],
    "additionalProperties": false
  },
  "mock": {
    "mode": "prepare_only"
  },
  "examples": [
    {
      "instruction": "把所有分区空调设为23度",
      "arguments": {
        "zone": "all",
        "temperature_c": 23
      }
    }
  ]
}
