{
  "id": "control.seats.set_massage",
  "version": "1.0.0",
  "kind": "control",
  "category_path": [
    "control",
    "seats"
  ],
  "title": "设置座椅按摩",
  "description": "设置座椅按摩。仅生成调用结构，所有范围为模拟定义，不执行真实车辆控制。",
  "aliases": [
    "设置座椅按摩",
    "座椅",
    "set massage"
  ],
  "enabled": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "seat": {
        "type": "string",
        "enum": [
          "driver",
          "passenger",
          "rear_left",
          "rear_right"
        ],
        "description": "主驾、副驾、后排左侧、后排右侧"
      },
      "mode": {
        "type": "string",
        "enum": [
          "off",
          "wave",
          "pulse"
        ]
      },
      "intensity": {
        "type": "integer",
        "minimum": 0,
        "maximum": 3
      }
    },
    "required": [
      "seat",
      "mode",
      "intensity"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "prepared": {
        "const": true
      }
    },
    "required": [
      "prepared"
    ],
    "additionalProperties": false
  },
  "mock": {
    "mode": "prepare_only"
  },
  "examples": [
    {
      "instruction": "主驾座椅开启波浪按摩，强度二档",
      "arguments": {
        "seat": "driver",
        "mode": "wave",
        "intensity": 2
      }
    }
  ]
}
