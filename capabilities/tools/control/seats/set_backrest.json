{
  "id": "control.seats.set_backrest",
  "version": "1.0.0",
  "kind": "control",
  "category_path": [
    "control",
    "seats"
  ],
  "title": "调节座椅靠背",
  "description": "调节座椅靠背。仅生成调用结构，所有范围为模拟定义，不执行真实车辆控制。",
  "aliases": [
    "调节座椅靠背",
    "座椅",
    "set backrest"
  ],
  "enabled": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "seat": {
        "type": "string",
        "enum": [
          "driver",
          "passenger",
          "rear_left",
          "rear_right"
        ],
        "description": "主驾、副驾、后排左侧、后排右侧"
      },
      "angle_deg": {
        "type": "integer",
        "minimum": 90,
        "maximum": 130
      }
    },
    "required": [
      "seat",
      "angle_deg"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "prepared": {
        "const": true
      }
    },
    "required": [
      "prepared"
    ],
    "additionalProperties": false
  },
  "mock": {
    "mode": "prepare_only"
  },
  "examples": [
    {
      "instruction": "副驾座椅靠背设为110度",
      "arguments": {
        "seat": "passenger",
        "angle_deg": 110
      }
    }
  ]
}
