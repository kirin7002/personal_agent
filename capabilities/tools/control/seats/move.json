{
  "id": "control.seats.move",
  "version": "1.0.0",
  "kind": "control",
  "category_path": [
    "control",
    "seats"
  ],
  "title": "调节座椅前后位置",
  "description": "调节座椅前后位置。仅生成调用结构，所有范围为模拟定义，不执行真实车辆控制。",
  "aliases": [
    "调节座椅前后位置",
    "座椅",
    "move"
  ],
  "enabled": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "seat": {
        "type": "string",
        "enum": [
          "driver",
          "passenger",
          "rear_left",
          "rear_right"
        ],
        "description": "主驾、副驾、后排左侧、后排右侧"
      },
      "direction": {
        "type": "string",
        "enum": [
          "forward",
          "backward"
        ]
      },
      "distance_mm": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      }
    },
    "required": [
      "seat",
      "direction",
      "distance_mm"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "prepared": {
        "const": true
      }
    },
    "required": [
      "prepared"
    ],
    "additionalProperties": false
  },
  "mock": {
    "mode": "prepare_only"
  },
  "examples": [
    {
      "instruction": "主驾座椅向后移动20毫米",
      "arguments": {
        "seat": "driver",
        "direction": "backward",
        "distance_mm": 20
      }
    }
  ]
}
