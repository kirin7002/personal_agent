{
  "id": "control.seats.set_ventilation",
  "version": "1.0.0",
  "kind": "control",
  "category_path": [
    "control",
    "seats"
  ],
  "title": "设置座椅通风",
  "description": "设置座椅通风。仅生成调用结构，所有范围为模拟定义，不执行真实车辆控制。",
  "aliases": [
    "设置座椅通风",
    "座椅",
    "set ventilation"
  ],
  "enabled": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "seat": {
        "type": "string",
        "enum": [
          "driver",
          "passenger",
          "rear_left",
          "rear_right"
        ],
        "description": "主驾、副驾、后排左侧、后排右侧"
      },
      "level": {
        "type": "integer",
        "minimum": 0,
        "maximum": 3
      }
    },
    "required": [
      "seat",
      "level"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "prepared": {
        "const": true
      }
    },
    "required": [
      "prepared"
    ],
    "additionalProperties": false
  },
  "mock": {
    "mode": "prepare_only"
  },
  "examples": [
    {
      "instruction": "副驾座椅通风设为三档",
      "arguments": {
        "seat": "passenger",
        "level": 3
      }
    }
  ]
}
