{
  "id": "control.seats.save_memory",
  "version": "1.0.0",
  "kind": "control",
  "category_path": [
    "control",
    "seats"
  ],
  "title": "保存座椅记忆",
  "description": "保存座椅记忆。仅生成调用结构，所有范围为模拟定义，不执行真实车辆控制。",
  "aliases": [
    "保存座椅记忆",
    "座椅",
    "save memory"
  ],
  "enabled": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "seat": {
        "type": "string",
        "enum": [
          "driver",
          "passenger",
          "rear_left",
          "rear_right"
        ],
        "description": "主驾、副驾、后排左侧、后排右侧"
      },
      "slot": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3
      }
    },
    "required": [
      "seat",
      "slot"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "prepared": {
        "const": true
      }
    },
    "required": [
      "prepared"
    ],
    "additionalProperties": false
  },
  "mock": {
    "mode": "prepare_only"
  },
  "examples": [
    {
      "instruction": "将主驾座椅当前位置保存为记忆一",
      "arguments": {
        "seat": "driver",
        "slot": 1
      }
    }
  ]
}
