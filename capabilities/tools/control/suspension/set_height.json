{
  "id": "control.suspension.set_height",
  "version": "1.0.0",
  "kind": "control",
  "category_path": [
    "control",
    "suspension"
  ],
  "title": "调整空气悬架高度",
  "description": "raise/lower 表示升高或降低一档；set 时必须给出 low/normal/high 高度。仅生成调用结构，所有范围为模拟定义，不执行真实车辆控制。",
  "aliases": [
    "调整空气悬架高度",
    "悬架",
    "set height"
  ],
  "enabled": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "raise",
          "lower",
          "set"
        ]
      },
      "height": {
        "type": "string",
        "enum": [
          "low",
          "normal",
          "high"
        ]
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "action": {
              "const": "set"
            }
          }
        },
        "then": {
          "required": [
            "height"
          ]
        },
        "else": {
          "not": {
            "required": [
              "height"
            ]
          }
        }
      }
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "prepared": {
        "const": true
      }
    },
    "required": [
      "prepared"
    ],
    "additionalProperties": false
  },
  "mock": {
    "mode": "prepare_only"
  },
  "examples": [
    {
      "instruction": "把空气悬架升高一档",
      "arguments": {
        "action": "raise"
      }
    }
  ],
  "preconditions": [
    {
      "pointer": "/equipment/air_suspension",
      "equals": true,
      "code": "NOT_EQUIPPED",
      "message": "该模拟车辆未配备空气悬架"
    },
    {
      "pointer": "/interfaces/suspension",
      "equals": true,
      "code": "INTERFACE_UNAVAILABLE",
      "message": "模拟车辆有配置，但当前未开放悬架接口"
    },
    {
      "pointer": "/state/driving/is_parked",
      "equals": true,
      "code": "PRECONDITION_NOT_MET",
      "message": "本模拟悬架接口要求车辆处于驻车状态"
    }
  ]
}
