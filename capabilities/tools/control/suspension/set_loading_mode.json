{
  "id": "control.suspension.set_loading_mode",
  "version": "1.0.0",
  "kind": "control",
  "category_path": [
    "control",
    "suspension"
  ],
  "title": "悬架装载模式",
  "description": "悬架装载模式。仅生成调用结构，所有范围为模拟定义，不执行真实车辆控制。",
  "aliases": [
    "悬架装载模式",
    "悬架",
    "set loading mode"
  ],
  "enabled": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean"
      }
    },
    "required": [
      "enabled"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "prepared": {
        "const": true
      }
    },
    "required": [
      "prepared"
    ],
    "additionalProperties": false
  },
  "mock": {
    "mode": "prepare_only"
  },
  "examples": [
    {
      "instruction": "开启悬架装载模式",
      "arguments": {
        "enabled": true
      }
    }
  ],
  "preconditions": [
    {
      "pointer": "/equipment/air_suspension",
      "equals": true,
      "code": "NOT_EQUIPPED",
      "message": "该模拟车辆未配备空气悬架"
    },
    {
      "pointer": "/interfaces/suspension",
      "equals": true,
      "code": "INTERFACE_UNAVAILABLE",
      "message": "模拟车辆有配置，但当前未开放悬架接口"
    },
    {
      "pointer": "/state/driving/is_parked",
      "equals": true,
      "code": "PRECONDITION_NOT_MET",
      "message": "本模拟悬架接口要求车辆处于驻车状态"
    }
  ]
}
