{
  "id": "manual.multimedia.lookup",
  "version": "1.0.0",
  "kind": "manual",
  "category_path": [
    "manual",
    "multimedia"
  ],
  "title": "查询多媒体车书",
  "description": "查询模拟多媒体使用说明与限制，不证明本车实际配备。",
  "aliases": [
    "多媒体",
    "说明书",
    "车书",
    "multimedia"
  ],
  "enabled": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "topic": {
        "type": "string",
        "enum": [
          "overview"
        ],
        "description": "overview 表示功能概述、用法和限制"
      }
    },
    "required": [
      "topic"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "source": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "document": {
            "type": "string"
          },
          "section": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "document",
          "section"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "title",
      "text",
      "source"
    ],
    "additionalProperties": false
  },
  "mock": {
    "mode": "argument_lookup",
    "argument": "topic",
    "cases": {
      "overview": {
        "title": "多媒体使用说明（模拟）",
        "text": "模拟车型的多媒体功能包括：音量、静音、播放、音源、曲目、进度与播放模式。参数范围以工具 Schema 为准，本说明不是实际车辆手册。",
        "source": {
          "kind": "mock_manual",
          "document": "demo-vehicle-manual-v1",
          "section": "multimedia"
        }
      }
    }
  },
  "examples": [
    {
      "instruction": "查一下车书里的多媒体功能说明",
      "arguments": {
        "topic": "overview"
      }
    }
  ]
}
